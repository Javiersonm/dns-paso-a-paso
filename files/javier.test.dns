$TTL    86400
@   IN  SOA debian.javier.test. admin.javier.test. (
            2026101501 ; Serial
            3600       ; Refresh
            1800       ; Retry
            604800     ; Expire
            86400 )    ; Negative Cache TTL
;
@                       IN  NS      debian.javier.test.
debian.javier.test.     IN  A       192.168.56.10
web                     IN  CNAME   debian.javier.test.
@                       IN  TXT     "Javiersonm"